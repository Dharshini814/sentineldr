# SentinelDR Phone Node Configuration Template (Port 8001)
# Runtime: Android Termux / Python standard library http.server / SQLite only

SDR_CLUSTER_ID=sentineldr-cluster-01
SDR_NODE_ID=phone
SDR_HOST=0.0.0.0
SDR_PORT=8001
SDR_INITIAL_ROLE=SECONDARY_STANDBY
SDR_INITIAL_EPOCH=1

# Peer endpoint (Laptop)
SDR_PEER_URL=http://127.0.0.1:8000

# SQLite Database
SDR_SQLITE_PATH=phone_sentineldr.db

# Secrets (Keep distinct from Admin Key)
SDR_HMAC_SECRET=phone_hmac_shared_secret_placeholder_change_me
SDR_ADMIN_KEY=phone_admin_bearer_key_placeholder_change_me

# Nonce cache database
SDR_NONCE_CACHE_DB=phone_nonce_cache.db
SDR_TIMESTAMP_WINDOW_SECONDS=30.0
