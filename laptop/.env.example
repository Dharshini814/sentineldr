# SentinelDR Laptop Node Configuration Template (Port 8000)
# Runtime: Windows / Python 3.13+ / FastAPI / PostgreSQL

SDR_CLUSTER_ID=sentineldr-cluster-01
SDR_NODE_ID=laptop
SDR_HOST=0.0.0.0
SDR_PORT=8000
SDR_INITIAL_ROLE=PRIMARY_ACTIVE
SDR_INITIAL_EPOCH=1

# Peer endpoint (Phone)
SDR_PEER_URL=http://127.0.0.1:8001

# Database Configuration
DATABASE_URL=postgresql://sentinel_user:sentinel_password@localhost:5432/sentineldr
SDR_DEV_FALLBACK_SQLITE=1

# Secrets (Keep distinct from Admin Key)
SDR_HMAC_SECRET=laptop_hmac_shared_secret_placeholder_change_me
SDR_ADMIN_KEY=laptop_admin_bearer_key_placeholder_change_me

# Nonce cache database
SDR_NONCE_CACHE_DB=laptop_nonce_cache.db
SDR_TIMESTAMP_WINDOW_SECONDS=30.0
