# SentinelDR Root Environment Configuration Template
# Copy to .env and configure secrets before production use.

SDR_CLUSTER_ID=sentineldr-cluster-01

# Cryptographic Secrets (MUST be distinct 256-bit random hex strings in production)
# NEVER commit the actual secrets to version control.
SDR_HMAC_SECRET=your_32_byte_hmac_secret_here_change_in_production
SDR_ADMIN_KEY=your_secure_admin_api_bearer_token_here_change_in_production

# Timing and Security
SDR_TIMESTAMP_WINDOW_SECONDS=30.0
